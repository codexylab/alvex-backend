# =============================================================
# ALVEX Backend — Environment Configuration
# =============================================================
# Copy this file as .env and fill in your values.
# Never commit .env to version control.

# --- Server ---
PORT=8080
ENV=development

# --- Database ---
# Production: reference Railway PostgreSQL's private DATABASE_URL variable.
# Local example: postgres://postgres:password@localhost:5432/alvex_db?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/alvex_db?sslmode=disable

# --- Supabase Authentication ---
# Auth only. Application data remains in Railway PostgreSQL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secret key (sb_secret_...). Never expose this to Vercel/browser variables.
SUPABASE_SECRET_KEY=

# Public Vercel application origin used for auth invitation redirects.
FRONTEND_URL=http://localhost:3000
# Public Railway HTTPS URL used by Vercel widget embed snippets (never a private service URL).
PUBLIC_API_URL=http://localhost:8080

# Optional local-only bearer token. Never configure this in staging/production.
DEV_TOKEN=

# --- API Key Encryption ---
# Generate a unique production value and store it only in Railway secrets.
# Keep old 32-byte keys temporarily in ENCRYPTION_PREVIOUS_KEYS while records
# are re-encrypted with the current key. Separate multiple values with commas.
ENCRYPTION_KEY=
ENCRYPTION_PREVIOUS_KEYS=

# --- AI Providers (add keys for providers you use) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# --- Stripe Billing (optional; configure both values together) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- WhatsApp Business API ---
# Configure both values together; verification fails closed when omitted.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Pin the Meta Graph API version configured for your app, for example https://graph.facebook.com/vXX.X
WHATSAPP_GRAPH_API_BASE_URL=

# --- Monitoring (optional) ---
SENTRY_DSN=
# Receives payload-free JSON alerts when a durable job exhausts all retries.
# Use HTTPS outside local development.
ALERT_WEBHOOK_URL=

# --- CORS Allowed Origins ---
# Add exact trusted frontend origins here (separate multiple with commas).
# Never use * because credentialed requests are enabled.
ALLOWED_ORIGINS=http://localhost:3000
