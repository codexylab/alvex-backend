# =============================================================
# ALVEX Backend — Environment Configuration
# =============================================================
# Copy this file as .env and fill in your values.
# Never commit .env to version control.

# --- Server ---
PORT=8080
ENV=development

# --- Database (Supabase PostgreSQL) ---
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Use 'Transaction mode' connection (port 6543) for best compatibility
# Local example: postgres://postgres:password@localhost:5432/alvex_db?sslmode=disable
# Supabase example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/alvex_db?sslmode=disable

# --- Clerk Authentication ---
# Get these from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get webhook secret from: Clerk Dashboard → Webhooks → Your Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- API Key Encryption (AES-256 — must be exactly 32 characters) ---
# Generate with: openssl rand -base64 24
# IMPORTANT: Never change this after first deploy — existing encrypted keys will break!
ENCRYPTION_KEY=alvex-encrypt-key-32chars-padded!

# --- AI Providers (add keys for providers you use) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# --- Stripe Billing (optional — add later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Business API ---
WHATSAPP_VERIFY_TOKEN=alvex-wa-verify-token
WHATSAPP_APP_SECRET=

# --- CORS Allowed Origins ---
# Add your frontend URL here (separate multiple with commas)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
